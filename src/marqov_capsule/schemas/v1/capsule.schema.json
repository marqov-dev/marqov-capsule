{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marqov.ai/schemas/capsule/v1/capsule.schema.json",
  "title": "Marqov Capsule Manifest",
  "description": "Schema for Marqov Capsule manifest file (capsule.yaml)",
  "type": "object",
  "required": [
    "version",
    "name",
    "description",
    "created_at",
    "created_by",
    "capsule_format_version",
    "lifecycle_state",
    "workflow_ref",
    "environment_ref",
    "backends_ref",
    "provenance",
    "digests"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Schema version (semver)"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*[a-z0-9]$",
      "minLength": 3,
      "maxLength": 64,
      "description": "Capsule name (kebab-case)"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Brief description of the capsule"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "created_by": {
      "type": "string",
      "format": "email",
      "description": "Email of creator"
    },
    "capsule_format_version": {
      "type": "string",
      "description": "Version of the marqov-capsule package that created this capsule"
    },
    "creator_version": {
      "type": "string",
      "description": "Version of the tool that created this capsule (e.g. Marqov platform version)"
    },
    "marqov_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$",
      "description": "Deprecated alias for capsule_format_version. Use capsule_format_version instead."
    },
    "lifecycle_state": {
      "type": "string",
      "enum": ["draft", "runnable", "sealed", "archived"],
      "description": "Current lifecycle state"
    },
    "workflow_ref": {
      "type": "string",
      "pattern": "^[^/].*\\.yaml$",
      "description": "Relative path to workflow.yaml"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[^/].*\\.yaml$",
      "description": "Relative path to environment.yaml"
    },
    "backends_ref": {
      "type": "string",
      "pattern": "^[^/].*\\.yaml$",
      "description": "Relative path to backends.yaml"
    },
    "sealed_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ],
      "description": "When capsule was sealed (null if not sealed)"
    },
    "sealed_by": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "email"}
      ],
      "description": "Who sealed the capsule (null if not sealed)"
    },
    "provenance": {
      "type": "object",
      "required": ["run_id"],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "UUID v4"
        },
        "git_sha": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{7,40}$"}
          ],
          "description": "Git commit SHA (7 or 40 characters)"
        },
        "git_repo": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "uri"}
          ],
          "description": "Git repository URL"
        },
        "parent_capsule_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
          ],
          "description": "Parent capsule UUID (if derived)"
        },
        "related_capsule_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "description": "List of related capsule UUIDs"
        },
        "custom_metadata": {
          "type": "object",
          "description": "Arbitrary key-value metadata"
        }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "regulatory_framework": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "enum": ["FDA-21CFR11", "NIH-DMSP", "EMA-GCP", "HIPAA"]}
          ],
          "description": "Regulatory framework"
        },
        "retention_years": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 99}
          ],
          "description": "Data retention period in years"
        },
        "doi": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^10\\.\\d{4,}/[-._;()/:A-Za-z0-9]+$"}
          ],
          "description": "Digital Object Identifier"
        },
        "embargo_until": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ],
          "description": "Embargo release date"
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["signer", "role", "timestamp"],
            "properties": {
              "signer": {"type": "string", "format": "email"},
              "role": {"type": "string"},
              "timestamp": {"type": "string", "format": "date-time"},
              "signature_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "digests": {
      "type": "object",
      "required": ["workflow", "environment", "backends", "data", "results", "provenance"],
      "properties": {
        "workflow": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "environment": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "backends": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "data": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "results": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        },
        "provenance": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "max_budget_usd": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        },
        "estimated_cost_usd": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        },
        "actual_cost_usd": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        },
        "cost_breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["task_id", "backend", "cost_usd"],
            "properties": {
              "task_id": {"type": "string"},
              "backend": {"type": "string"},
              "cost_usd": {"type": "number", "minimum": 0},
              "shots": {"type": "integer", "minimum": 1},
              "wall_time_seconds": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "start_time": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "end_time": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "wall_time_seconds": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        },
        "total_queue_time_seconds": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        },
        "exit_code": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer"}
          ]
        },
        "exit_message": {
          "oneOf": [
            {"type": "null"},
            {"type": "string"}
          ]
        },
        "num_tasks": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "total_shots": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 0}
          ]
        },
        "carbon_footprint_kg_co2": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 0}
          ]
        }
      }
    },
    "verifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verification_id", "timestamp", "verifier", "method", "result"],
        "properties": {
          "verification_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "timestamp": {"type": "string", "format": "date-time"},
          "verifier": {"type": "string", "format": "email"},
          "method": {"type": "string", "enum": ["replay", "statistical", "manual"]},
          "result": {"type": "string", "enum": ["passed", "failed", "warning"]},
          "backend": {"type": "string"},
          "details": {"type": "object"}
        }
      }
    },
    "reproducibility_tier": {
      "type": "string",
      "enum": ["deterministic", "statistical", "verification-only"],
      "description": "Declares the expected reproducibility level of this capsule"
    },
    "extensions": {
      "type": "object",
      "description": "Reserved for future schema extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"lifecycle_state": {"const": "sealed"}}
      },
      "then": {
        "required": ["sealed_at", "sealed_by"],
        "properties": {
          "sealed_at": {"type": "string", "format": "date-time"},
          "sealed_by": {"type": "string", "format": "email"}
        }
      }
    },
    {
      "if": {
        "properties": {"lifecycle_state": {"const": "archived"}}
      },
      "then": {
        "required": ["sealed_at", "sealed_by"],
        "properties": {
          "sealed_at": {"type": "string", "format": "date-time"},
          "sealed_by": {"type": "string", "format": "email"}
        }
      }
    }
  ]
}
