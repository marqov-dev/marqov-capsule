{
  "description": "Golden vectors for spec v1 section 6 (count-equivalence decision procedure). Expected values are derived from the normative formula in the specification, not produced by the reference implementation.",
  "formula": {
    "tvd_point": "0.5 * sum(abs(p_hat[i] - q_hat[i])) over the union of outcomes, zero for absent counts",
    "slack": "sqrt(0.5 * ln(1 / alpha) * (1 / n + 1 / m))",
    "tvd_ucb": "min(1, tvd_point + slack)"
  },
  "tolerance": 1e-09,
  "tolerance_note": "Compare floats within this absolute tolerance; libm differences across languages and platforms make exact bit equality an unreasonable conformance requirement.",
  "cases": [
    {
      "name": "identical-two-outcome-1024",
      "note": "Identical inputs at 1024 shots. TVD is exactly 0; the bound is pure slack (~0.054), which exceeds any usable epsilon. Must be INCONCLUSIVE, never REJECTED.",
      "ref_counts": {
        "00": 512,
        "11": 512
      },
      "new_counts": {
        "00": 512,
        "11": 512
      },
      "settings": {
        "alpha": 0.05,
        "epsilon": 0.02,
        "min_shots": 100
      },
      "expected": {
        "verdict": "INCONCLUSIVE",
        "stage": "bound-computed",
        "total_variation_distance": 0.0,
        "tvd_ucb": 0.05408807445632142
      }
    },
